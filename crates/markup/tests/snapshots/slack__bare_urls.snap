paragraph
  "see "
  "https://example.com/a_b_c" -> https://example.com/a_b_c
  ". and ("
  "https://example.com/x" -> https://example.com/x
  ") or "
  "https://en.wikipedia.org/wiki/Foo_(bar)" -> https://en.wikipedia.org/wiki/Foo_(bar)
  ", nothttps://x.y"
