#!/usr/bin/env bash
set -euo pipefail

# Use only system tools so the image matches the signing environment.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

if [[ $# -ne 2 ]]; then
  echo "usage: create-macos-dmg APP DMG" >&2
  exit 2
fi
app=$1
dmg=$2
if [[ $(basename "$app") != Draftmux.app || -L $app || ! -d $app ]]; then
  echo "expected a Draftmux.app bundle directory: $app" >&2
  exit 2
fi
if [[ $dmg != *.dmg ]]; then
  echo "disk image name must end in .dmg: $dmg" >&2
  exit 2
fi
if [[ -e $dmg || -L $dmg ]]; then
  echo "refusing to replace existing disk image: $dmg" >&2
  exit 2
fi
if [[ ! -d $(dirname "$dmg") ]]; then
  echo "output directory not found: $(dirname "$dmg")" >&2
  exit 2
fi

layout_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/macos/dmg"
tmp_root=${TMPDIR:-/tmp}
work_dir=$(mktemp -d "$tmp_root/draftmux-dmg.XXXXXX")
attached=0
cleanup() {
  local status=$?
  if [[ $attached == 1 ]]; then
    hdiutil detach -quiet "$work_dir/mount" || hdiutil detach -quiet -force "$work_dir/mount" || status=1
  fi
  rm -rf "$work_dir"
  exit "$status"
}
trap cleanup EXIT

# The window shows the app beside a link to drag it onto, laid out by the
# committed DS_Store and background from scripts/generate-macos-dmg-layout.
volume="$work_dir/Draftmux"
mkdir "$volume" "$volume/.background" "$work_dir/mount"
ditto "$app" "$volume/Draftmux.app"
ln -s /Applications "$volume/Applications"
cp "$layout_dir/DS_Store" "$volume/.DS_Store"
cp "$layout_dir/background.tiff" "$volume/.background/background.tiff"
cp "$app/Contents/Resources/AppIcon.icns" "$volume/.VolumeIcon.icns"
# hdiutil's stdout goes to stderr: this script's stdout is only the image path.
# create fails now and then with "Resource busy" while another image detaches.
for attempt in 1 2 3 4 5; do
  if hdiutil create -volname Draftmux -srcfolder "$volume" -fs HFS+ -format UDRW "$work_dir/layout.dmg" >&2; then
    break
  fi
  rm -f "$work_dir/layout.dmg"
  [[ $attempt == 5 ]] && exit 1
  sleep $((attempt * 2))
done

# Finder shows .VolumeIcon.icns once the volume root has the kHasCustomIcon
# flag. Draftmux.app gets no Finder flags: strict signature checks reject them,
# and Finder already hides the .app extension of bundles.
hdiutil attach -nobrowse -noautoopen -mountpoint "$work_dir/mount" "$work_dir/layout.dmg" >&2
attached=1
xattr -wx com.apple.FinderInfo 0000000000000000040000000000000000000000000000000000000000000000 "$work_dir/mount"
rm -rf "$work_dir/mount/.fseventsd" "$work_dir/mount/.Trashes"
hdiutil detach "$work_dir/mount" >&2
attached=0
hdiutil convert "$work_dir/layout.dmg" -format UDZO -o "$dmg" >&2
echo "$dmg"
