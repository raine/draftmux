#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
create="$script_dir/create-macos-dmg"
check="$script_dir/check-macos-dmg"
tmp=$(mktemp -d)
trap '/usr/bin/hdiutil detach -quiet "$tmp/mount" 2>/dev/null || true; rm -rf "$tmp"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}
reject() {
  if "$@" >"$tmp/rejection.log" 2>&1; then
    fail "accepted invalid input: $*"
  fi
}
# Fixture images carry the window layout so each is rejected for its own flaw.
image_from() {
  mkdir -p "$1/.background"
  cp "$script_dir/../macos/dmg/DS_Store" "$1/.DS_Store"
  cp "$script_dir/../macos/dmg/background.tiff" "$1/.background/background.tiff"
  cp "$app/Contents/Resources/AppIcon.icns" "$1/.VolumeIcon.icns"
  /usr/bin/hdiutil create -quiet -volname Draftmux -srcfolder "$1" -fs HFS+ -format UDZO "$2"
}

printf '#!/bin/sh\necho "draftmux $*"\n' >"$tmp/draftmux"
mkdir "$tmp/app"
"$script_dir/assemble-macos-app" "$tmp/draftmux" 1.2.3 "$tmp/app" >/dev/null
app="$tmp/app/Draftmux.app"
identifier=$(/usr/bin/plutil -extract CFBundleIdentifier raw "$script_dir/../macos/Info.plist")
/usr/bin/codesign --force --sign - --identifier "$identifier" "$app" 2>/dev/null

[[ $("$create" "$app" "$tmp/Draftmux.dmg") == "$tmp/Draftmux.dmg" ]] || fail "unexpected image path"
"$check" "$tmp/Draftmux.dmg" "$app" >/dev/null || fail "created image did not pass its check"
/usr/bin/hdiutil imageinfo "$tmp/Draftmux.dmg" | grep -q 'Format: UDZO' || fail "image is not compressed"
/usr/bin/hdiutil attach -quiet -readonly -nobrowse -noautoopen -mountpoint "$tmp/mount" "$tmp/Draftmux.dmg"
[[ $(/usr/bin/xattr -px com.apple.FinderInfo "$tmp/mount" | tr -d ' \n') == 00000000000000000400* ]] ||
  fail "volume icon flag is not set"
[[ $(/usr/bin/xattr "$tmp/mount/Draftmux.app") != *com.apple.FinderInfo* ]] || fail "Draftmux.app carries Finder metadata"
/usr/bin/hdiutil detach -quiet "$tmp/mount"

reject "$create" "$app" "$tmp/Draftmux.dmg"
reject "$create" "$app" "$tmp/Draftmux.img"
reject "$create" "$app" "$tmp/missing/Draftmux.dmg"
reject "$create" "$tmp/app" "$tmp/Other.dmg"
reject "$create" "$app"
[[ ! -e $tmp/Other.dmg ]] || fail "rejected creation left an image"

# The check fails for an image built from different bytes.
cp -R "$app" "$tmp/Changed.app"
printf x >>"$tmp/Changed.app/Contents/Resources/AppIcon.icns"
reject "$check" "$tmp/Draftmux.dmg" "$tmp/Changed.app"

mkdir -p "$tmp/extra"
cp -R "$app" "$tmp/extra/Draftmux.app"
ln -s /Applications "$tmp/extra/Applications"
touch "$tmp/extra/README"
image_from "$tmp/extra" "$tmp/extra.dmg"
reject "$check" "$tmp/extra.dmg" "$app"

# A plain image without the window layout is rejected.
mkdir -p "$tmp/plain"
cp -R "$app" "$tmp/plain/Draftmux.app"
ln -s /Applications "$tmp/plain/Applications"
/usr/bin/hdiutil create -quiet -volname Draftmux -srcfolder "$tmp/plain" -fs HFS+ -format UDZO "$tmp/plain.dmg"
reject "$check" "$tmp/plain.dmg" "$app"

# Finder metadata on the bundle breaks its strict signature check.
mkdir -p "$tmp/flagged"
cp -R "$app" "$tmp/flagged/Draftmux.app"
/usr/bin/xattr -wx com.apple.FinderInfo 0000000000000000001000000000000000000000000000000000000000000000 "$tmp/flagged/Draftmux.app"
ln -s /Applications "$tmp/flagged/Applications"
image_from "$tmp/flagged" "$tmp/flagged.dmg"
reject "$check" "$tmp/flagged.dmg" "$app"

mkdir -p "$tmp/link"
cp -R "$app" "$tmp/link/Draftmux.app"
ln -s /tmp "$tmp/link/Applications"
image_from "$tmp/link" "$tmp/link.dmg"
reject "$check" "$tmp/link.dmg" "$app"

mkdir -p "$tmp/nolink"
cp -R "$app" "$tmp/nolink/Draftmux.app"
image_from "$tmp/nolink" "$tmp/nolink.dmg"
reject "$check" "$tmp/nolink.dmg" "$app"

echo "ok: disk image holds the exact Draftmux.app, an Applications link and the window layout; existing, misnamed, unstyled and incomplete images rejected"
