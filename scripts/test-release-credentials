#!/usr/bin/env bash
# Checks that the signing, notarization and release scripts stop with a
# message naming what is missing, before they build, sign or submit anything.
# Every case lacks at least one credential, so nothing reaches Apple.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/Draftmux.app"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}
names=(APPLE_DEVELOPER_ID_CERT_BASE64 APPLE_DEVELOPER_ID_CERT_PASSWORD APPLE_DEVELOPER_ID_IDENTITY
  APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8)
clean_env=()
for name in "${names[@]}"; do clean_env+=(-u "$name"); done

# Runs a script with only the given credentials set and expects it to fail
# with a message containing $1.
expect_failure() {
  local message=$1
  shift
  local status=0
  env "${clean_env[@]}" "$@" >"$tmp/out.log" 2>&1 || status=$?
  [[ $status != 0 ]] || fail "succeeded: $*"
  grep -qF -- "$message" "$tmp/out.log" || fail "no '$message' from: $* ($(<"$tmp/out.log"))"
}

sign="$script_dir/sign-macos-release"
expect_failure "missing signing certificate" "$sign" "$tmp/Draftmux.app"
expect_failure "missing Apple Developer team ID" \
  APPLE_DEVELOPER_ID_CERT_BASE64=x APPLE_DEVELOPER_ID_CERT_PASSWORD=x \
  APPLE_DEVELOPER_ID_IDENTITY="Developer ID Application: X (ABCDE12345)" "$sign" "$tmp/Draftmux.app"
expect_failure "must be a Developer ID Application identity" \
  APPLE_DEVELOPER_ID_CERT_BASE64=x APPLE_DEVELOPER_ID_CERT_PASSWORD=x \
  APPLE_DEVELOPER_ID_IDENTITY="Apple Development: X" APPLE_TEAM_ID=ABCDE12345 "$sign" "$tmp/Draftmux.app"
expect_failure "usage:" "$sign"

notarize="$script_dir/notarize-macos-release"
expect_failure "missing App Store Connect API key ID" "$notarize" "$tmp/Draftmux.app"
expect_failure "missing App Store Connect API private key" \
  ASC_KEY_ID=ABC123 ASC_ISSUER_ID=x "$notarize" "$tmp/Draftmux.app"
expect_failure "must be alphanumeric" \
  ASC_KEY_ID='abc;rm' ASC_ISSUER_ID=x ASC_KEY_P8=x "$notarize" "$tmp/Draftmux.app"
expect_failure "usage:" "$notarize" "$tmp/Draftmux.app" "$tmp/Draftmux.app"
expect_failure "not found" ASC_KEY_ID=ABC123 ASC_ISSUER_ID=x ASC_KEY_P8=x "$notarize" "$tmp/missing.app"

expect_failure "missing release credentials: APPLE_DEVELOPER_ID_CERT_BASE64" \
  CARGO_TARGET_DIR="$tmp/target" "$script_dir/release-macos"
expect_failure "missing release credentials: ASC_KEY_P8 APPLE_TEAM_ID" \
  CARGO_TARGET_DIR="$tmp/target" APPLE_DEVELOPER_ID_CERT_BASE64=x APPLE_DEVELOPER_ID_CERT_PASSWORD=x \
  APPLE_DEVELOPER_ID_IDENTITY=x ASC_KEY_ID=x ASC_ISSUER_ID=x "$script_dir/release-macos"
[[ ! -e $tmp/target ]] || fail "release-macos built without credentials"

echo "ok: signing, notarization and release stop before any work when credentials are missing or malformed"
