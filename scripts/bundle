#!/usr/bin/env bash
# Builds Draftmux.app from this checkout and prints its path on stdout:
# target/release/Draftmux.app, or target/debug/Draftmux.app with --debug.
#
# The bundle holds the binary (app and CLI in one), the pi extension and the
# app icon. It is ad-hoc signed, which is enough to run locally built copies;
# scripts/release-macos signs and notarizes for distribution.
set -euo pipefail

usage() {
  echo "usage: bundle [--debug]" >&2
  exit 2
}
profile=release
case $# in
  0) ;;
  1) [[ $1 == --debug ]] || usage; profile=debug ;;
  *) usage ;;
esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target_dir="${CARGO_TARGET_DIR:-$root/target}"
out="$target_dir/$profile/Draftmux.app"

version="$(sed -n 's/^version = "\(.*\)"$/\1/p' "$root/crates/draftmux/Cargo.toml" | head -n 1)"
if [[ -z "$version" ]]; then
  echo "bundle: no version in crates/draftmux/Cargo.toml" >&2
  exit 1
fi

cargo_args=(--locked -p draftmux --manifest-path "$root/Cargo.toml" --target-dir "$target_dir")
if [[ $profile == release ]]; then cargo_args+=(--release); fi
cargo build "${cargo_args[@]}" >&2

staging="$(mktemp -d "$target_dir/$profile/.bundle.XXXXXX")"
trap 'rm -rf "$staging"' EXIT
app="$("$root/scripts/assemble-macos-app" "$target_dir/$profile/draftmux" "$version" "$staging")"
identifier="$(plutil -extract CFBundleIdentifier raw "$root/macos/Info.plist")"
codesign --force --identifier "$identifier" --sign - "$app" >&2
codesign --verify --strict "$app"

rm -rf "$out"
mv "$app" "$out"
echo "$out"
