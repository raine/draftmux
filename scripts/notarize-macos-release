#!/usr/bin/env bash
# Submits a signed Draftmux.app or disk image to Apple's notary service,
# waits for the result, and staples and validates the ticket. Needs an App
# Store Connect API key:
#
#   ASC_KEY_ID     the key ID
#   ASC_ISSUER_ID  the issuer ID
#   ASC_KEY_P8     the private key (.p8 contents)
set -euo pipefail

# Only system tools may handle the App Store Connect API key.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if [[ $# -ne 1 ]]; then
  echo "usage: notarize-macos-release APP_OR_DMG" >&2
  exit 2
fi
target=$1

: "${ASC_KEY_ID:?missing App Store Connect API key ID}"
: "${ASC_ISSUER_ID:?missing App Store Connect API issuer ID}"
: "${ASC_KEY_P8:?missing App Store Connect API private key}"

if [[ ! $ASC_KEY_ID =~ ^[A-Z0-9]+$ ]]; then
  echo "App Store Connect API key ID must be alphanumeric" >&2
  exit 2
fi

if [[ ! ( -f $target && $target == *.dmg ) && ! ( -d $target && $target == *.app ) ]]; then
  echo "app bundle or disk image not found: $target" >&2
  exit 2
fi

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/draftmux-notarization.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT
key="$work_dir/AuthKey_$ASC_KEY_ID.p8"
(umask 077 && printf '%s\n' "$ASC_KEY_P8" >"$key")
credentials=(--key "$key" --key-id "$ASC_KEY_ID" --issuer "$ASC_ISSUER_ID")

# A disk image is submitted as is; a bundle as a zip.
if [[ $target == *.dmg ]]; then
  submission=$target
else
  submission="$work_dir/submission.zip"
  ditto -c -k --sequesterRsrc --keepParent "$target" "$submission"
fi

# The exit status alone does not distinguish rejection, so read the result.
result="$work_dir/result.json"
xcrun notarytool submit "$submission" "${credentials[@]}" --wait \
  --timeout 1h --output-format json >"$result" || true
if ! submission_id=$(plutil -extract id raw -o - "$result" 2>/dev/null) ||
   ! status=$(plutil -extract status raw -o - "$result" 2>/dev/null); then
  echo "notarytool did not report a submission result" >&2
  exit 1
fi
echo "notarization $submission_id: $status"
if [[ $status != Accepted ]]; then
  xcrun notarytool log "$submission_id" "${credentials[@]}" >&2 || true
  echo "notarization was not accepted: $status" >&2
  exit 1
fi

"$script_dir/stapler" staple "$target"
"$script_dir/stapler" validate "$target"
